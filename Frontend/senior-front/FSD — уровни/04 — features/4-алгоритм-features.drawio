<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="fsd-levels" version="24.7.7">
  <diagram name="Алгоритм — features" id="alg-4-features">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Уровень 4: заслужило ли действие слой — Шаг 3 decision framework (SKILL.md §2)" style="text;html=1;align=center;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="16" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Кандидат на features: «кнопка + логика»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="Шаг 3-а: это ПОЛНОЕ пользовательское действие?&#xa;«пользователь хочет [ГЛАГОЛ] [СУЩЕСТВИТЕЛЬНОЕ]»&#xa;(кнопка + запрос + состояние = одно действие)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="Не действие, а данные + вид →&#xa;уровень 3 (entities)&#xa;Экран/композиция → уровень 2 (pages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="Шаг 3-б: несколько потребителей СЕЙЧАС?&#xa;(extraction rule ①: не гипотетически)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="440" y="290" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="Один потребитель / спекулятивное переиспользование&#xa;→ «keep in the page» (уровень 2)&#xa;«Do not extract single-use code» (§6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="Шаг 3-в: стабильная граница?&#xa;② своя причина меняться ③ сфокусированная&#xa;ответственность («в корзину» значит одно&#xa;и то же с любой страницы)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="God slice: «всё про пользователя»&#xa;→ разбить: auth / profile-edit /&#xa;password-reset (§6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="320" height="70" as="geometry" />
