<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="fsd-levels" version="24.7.7">
  <diagram name="Пример 1 — правило скидки" id="ex-3-is-on-sale">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Пример 1 (простой): правило «на скидке» разошлось → entities/product/model (Snapshot 2)" style="text;html=1;align=center;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="16" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="givenLbl" value="Дано (магазин)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#334155" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="given" value="Правило is-on-sale (цена ниже прейскурантной) живёт копиями на странице товара и в поиске.&#xa;&#xa;Маркетинг меняет смысл: скидка = цена ниже прейскурантной И товар в наличии. Страницу товара обновили, поиск — забыли. Поиск помечает «на скидке» то, что страница товара скидкой не считает." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="stepsLbl" value="Прогон алгоритма" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#334155" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="360" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. «This is the signal. The two copies are the same rule, they must agree, and they no longer do.» — расхождение копий = сигнал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Extraction rule: ① используются сейчас (2 страницы) ② своя причина меняться (маркетинг, не страницы) ③ сфокусированная ответственность («товар на скидке?» и ничего больше) — все три да" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10" vertex="1" parent="1">
          <mxGeometry x="400" y="195" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Шаг 4: бизнес-доменная модель, несколько потребителей → правило получает один дом: entities/product/model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="resLbl" value="Итог" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#334155" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="tree" value="src/&#xa;├── entities/                     ← новый слой&#xa;│   └── product/&#xa;│       ├── model/&#xa;│       │   └── is-on-sale.ts   ← один дом (обе копии удалены)&#xa;│       └── index.ts&#xa;├── pages/&#xa;│   ├── product/ui/SaleBadge.tsx  ← остался; зовёт isOnSale&#xa;│   └── search/ui/VideoCard-аналог ← зовёт тот же isOnSale&#xa;└── shared/&#xa;    └── api/product.ts             ← ProductDTO остался здесь" style="whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=11;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#64748b;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="code1" value="// entities/product/model/is-on-sale.ts&#xa;import { type ProductDTO } from &quot;@/shared/api/product&quot;;&#xa;&#xa;export const isOnSale = (p: ProductDTO): boolean =&gt;&#xa;  p.price &lt; p.listPrice &amp;&amp; p.inStock;&#xa;&#xa;// entities/product/index.ts&#xa;export { isOnSale } from &quot;./model/is-on-sale&quot;;&#xa;&#xa;// pages/search/ui/SearchCard.tsx — обе страницы зовут одно правило&#xa;import { isOnSale } from &quot;@/entities/product&quot;;&#xa;{isOnSale(video) &amp;&amp; &lt;SaleBadge /&gt;}" style="whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=10.5;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#64748b;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="820" y="370" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="Что НЕ поехало (Snapshot 2):&#xa;&#xa;• ProductDTO остался в shared/api — транспортный тип не едет в сущность вслед за логикой;&#xa;• бейдж и карточки остались в страницах — «Section 6 warns against adding UI to entities until there is a reason»;&#xa;• сущность = один файл + index. Этого достаточно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;fontSize=12;align=left;spacing=10;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="700" height="170" as="geometry" />
        </mxCell>
        <mxCell id="verdict" value="Вердикт: слой открылся правилом, а не количеством потребителей. Дизайн-детали копий (уровень 2) не открыли бы его; расхождение обязательного к согласованности правила — открыло." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=10" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;dashed=1" edge="1" parent="1" source="given" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;dashed=1" edge="1" parent="1" source="s3" target="tree">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
