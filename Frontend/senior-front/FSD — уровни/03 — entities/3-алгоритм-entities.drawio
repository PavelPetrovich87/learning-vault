<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="fsd-levels" version="24.7.7">
  <diagram name="Алгоритм — entities" id="alg-3-entities">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Уровень 3: заслужила ли сущность слой — Шаг 4 + extraction rule + фильтры excessive-entities" style="text;html=1;align=center;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="170" y="16" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Кандидат на entities: «общий» бизнес-код" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="Extraction rule — все 3 условия?&#xa;① используется в нескольких местах СЕЙЧАС&#xa;② своя причина меняться (независимо от потребителя)&#xa;③ сфокусированная ответственность" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="out1" value="Нет → остаётся где был:&#xa;страница (ур. 2) / фича (ур. 4).&#xa;«Do not extract single-use code»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="830" y="160" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="Фильтры из excessive-entities:&#xa;это действительно бизнес-модель?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="450" y="300" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="CRUD без бизнес-смысла → shared/api (один потребитель — в слайс)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="830" y="270" width="370" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="auth-данные (токены, login DTO) → shared/auth; user-сущность ради логина — анти-паттерн" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="830" y="340" width="370" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="просто тип API-ответа (DTO) → shared/api: «A transport type does not follow business logic into an entity»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11.5" vertex="1" parent="1">
          <mxGeometry x="830" y="410" width="370" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="entities/&lt;существительное&gt;/ — анатомия сущности" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="460" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ok1" value="model/&#xa;тип + правило + хранилище.&#xa;«The entity is one file and an index.&#xa;That is enough.» (Snapshot 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ok2" value="index.ts&#xa;публичный API: наружу — только то,&#xa;что нужно потребителям (правило 4-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="560" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ok3" value="ui/ — осторожно (§6)&#xa;вид, если на то есть причина;&#xa;импортируется только слоями ВЫШЕ&#xa;(features/pages/app), никогда — другой сущностью" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="840" y="560" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ok4" value="api/&#xa;запросы про сущность — только если несут&#xa;её правило; чистый CRUD остаётся в shared/api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="690" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Прежде чем заводить @x (уровень 5): несколько сущностей, завязанных друг на друга, — сигнал СЛИТЬ границы, а не заводить кросс-импорты. Изолированный бизнес-контекст лучше @x-цепочек." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;fontSize=11.5;align=left;spacing=10" vertex="1" parent="1">
          <mxGeometry x="640" y="690" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="golden" value="«A layer is earned by a stable responsibility that needs one home, not by a count of how many places use something.» — growth-walkthrough · «An FSD application without an entities layer is still FSD.» — excessive-entities" style="text;html=1;fontSize=11.5;fontColor=#7c2d12;align=center;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#fdba74;rounded=1" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1170" height="44" as="geometry" />
        </mxCell>
