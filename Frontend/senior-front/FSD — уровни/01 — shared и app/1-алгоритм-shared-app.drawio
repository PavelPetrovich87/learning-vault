        <mxCell id="q2" value="Шаг 2: переиспользуемая инфраструктура&#xa;без бизнес-логики?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="440" y="296" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q2note" value="«Business logic is a rule the product enforces on its own data, such as applying a discount to an order.» — SKILL.md §2&#xa;(Бизнес-логика — правило продукта о собственных данных, например скидка к заказу. Обмен данными с бэкендом и CRUD-boilerplate — НЕ бизнес-логика.)" style="text;html=1;fontSize=10.5;fontColor=#475569;align=left;whiteSpace=wrap" vertex="1" parent="1">
          <mxGeometry x="830" y="296" width="370" height="100" as="geometry" />
        </mxCell>
