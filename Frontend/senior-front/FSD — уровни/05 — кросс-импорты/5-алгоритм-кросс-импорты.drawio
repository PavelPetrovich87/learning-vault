        <mxCell id="t1a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;dashed=1" edge="1" parent="1" source="e1" target="e3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1a4" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;fontSize=11" edge="1" parent="1" source="e2" target="e4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1b" value="features / pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;fontSize=11" edge="1" parent="1" source="ql" target="fa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b" edge="1" parent="1" source="fa" target="fb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b" edge="1" parent="1" source="fb" target="fc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
