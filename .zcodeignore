# macOS
.DS_Store
._*

# Obsidian local state (cache/workspace — not vault content)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Node / cloned external repos (isolated under _reference/, not vault notes)
node_modules/

# Cloned external reference repos (~335 MB, re-cloneable from remotes)
# Keep only the README marker; ignore the actual repo contents
_reference/*
!/_reference/README.md

# Book source files (PDFs, docx, dmg — large binaries, not vault notes)
books/*

# Lockfiles / tooling artifacts
skills-lock.json

# Binary build artifacts
*.zip

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
