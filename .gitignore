# macOS
.DS_Store
._*

# Obsidian local state (cache/workspace — not vault content)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Obsidian drawio plugin (155 MB webapp bundle — re-installable from community store)
.obsidian/plugins/drawio/

# Node / cloned external repos (isolated under _reference/, not vault notes)
node_modules/

# Cloned external reference repos (~335 MB, re-cloneable from remotes)
# Keep only the README marker; ignore the actual repo contents
_reference/*
!/_reference/README.md

# Book source files (PDFs, docx, dmg — large binaries, not vault notes)
books/*

# Lockfiles / tooling artifacts
skills-lock.json

# ZCode agent session state (plans/config, per workspace)
.zcode/

# Binary build artifacts
*.zip
