  <diagram id="phrase-structure" name="Природа входа">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="deep" value="&lt;b&gt;ГЛУБИННАЯ СТРУКТУРА&lt;/b&gt;&lt;br&gt;первичный опыт — территория,&lt;br&gt;богаче любой карты (с. 23)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="675" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;1 · СЕНСОРНЫЕ КАНАЛЫ&lt;/b&gt;&lt;br&gt;что вообще может дойти:&lt;br&gt;органы чувств — «понижающий клапан» (с. 22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="515" width="330" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;2 · ВНУТРЕННИЕ ЗНАНИЯ&lt;/b&gt;&lt;br&gt;что замечаю и как читаю:&lt;br&gt;мысли · убеждения · ценности · самоощущение (с. 22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="355" width="330" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;3 · ЯЗЫК&lt;/b&gt;&lt;br&gt;как пакуется в слова:&lt;br&gt;глубинная структура → поверхностная (с. 17–18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
