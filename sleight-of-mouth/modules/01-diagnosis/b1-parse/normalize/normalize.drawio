<mxfile type="device">
  <diagram id="normalize" name="Нормализация звена">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="in" value="&lt;b&gt;звено&lt;/b&gt; — сырой текст после разреза&lt;br&gt;(шаг 4 разбора) или фрагмент-обобщение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="40" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;1 · СНЯТЬ ОБОЛОЧКУ&lt;/b&gt;&lt;br&gt;союзы · местоимения (я, мне, вы) · модальные&lt;br&gt;скобки · глаголы-операторы&lt;br&gt;&lt;i&gt;„приложил к этому слишком мало усилий“ → „слишком мало усилий“&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;2 · НОМИНАЛИЗОВАТЬ&lt;/b&gt;&lt;br&gt;предикация → именная группа, «не-» сохраняется&lt;br&gt;&lt;i&gt;„я не могу добиться успеха“ → „неспособность добиться успеха“&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="290" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;3 · СВЕРНУТЬ ОЦЕНКУ&lt;/b&gt;&lt;br&gt;оценочная предикация → прилагательное / существительное&lt;br&gt;&lt;i&gt;„здоровье никуда не годится“ → „плохое здоровье“&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="430" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;4 · ПРОВЕРКА ИНВАРИАНТОВ&lt;/b&gt;&lt;br&gt;смысл · отрицание · квантор · оценка — всё на месте?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="310" y="570" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="rb" value="&lt;b&gt;ОТКАТ&lt;/b&gt;&lt;br&gt;запасная форма (инфинитив)&lt;br&gt;или исходное звено как есть" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;АРТЕФАКТ: нормализованное обозначение&lt;/b&gt;&lt;br&gt;именая или инфинитивная группа (равноправны)&lt;br&gt;→ поле A / B карты (contracts/map)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="710" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inv" value="Инварианты — контракт качества" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="210" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="семантика не меняется —&lt;br&gt;это не рефрейминг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="inv">
          <mxGeometry x="20" y="40" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="i2" value="отрицание сохраняется&lt;br&gt;(«не-», «отсутствие»)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="inv">
          <mxGeometry x="20" y="110" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="i3" value="кванторы общности сохраняются —&lt;br&gt;материал для b2 (мишень II)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="inv">
          <mxGeometry x="20" y="180" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="i4" value="оценки сохраняются&lt;br&gt;(«плохое», «опасность»)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="inv">
          <mxGeometry x="20" y="250" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="i5" value="короче исходного при полной&lt;br&gt;семантике; лимита длины нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="inv">
          <mxGeometry x="20" y="320" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="in" target="n1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="нарушение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n4" target="rb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="ок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="n4" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="запасная форма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="rb" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="rounded=1;html=1;dashed=1;endArrow=none;strokeColor=#999999;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="inv" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
