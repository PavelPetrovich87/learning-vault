        </mxCell>
        <mxCell id="laneD" value="ДИАГНОСТИКА — заполняет карту" style="swimlane;startSize=30;fillColor=#e8f4f8;strokeColor=#6c8ebf;html=1;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
