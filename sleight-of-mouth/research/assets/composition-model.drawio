        <mxCell id="nMap" value="&lt;b&gt;КАРТА УБЕЖДЕНИЯ&lt;/b&gt;&lt;br&gt;тип: C-E («потому что»)&lt;br&gt;A: «нет способностей»&lt;br&gt;B: «не выучу английский»&lt;br&gt;&lt;br&gt;мишень I  основание   ▲ уязвим&lt;br&gt;мишень II следствие  ▲▲ сильная («никогда»)&lt;br&gt;мишень III масштаб   —&lt;br&gt;мишень IV рамка      —&lt;br&gt;мишень V мета        —" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;rounded=0;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="240" height="340" as="geometry"/>
        </mxCell>
