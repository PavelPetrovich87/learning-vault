  <diagram id="zapolnenie-ramki" name="Заполнение рамки">
    <mxGraphModel dx="1200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="in1" value="ВХОД ЭТАПА&lt;br&gt;источник: текст · человек · никто&lt;br&gt;данные: мешанина фракций или молчание&lt;br&gt;+ сущности домена (приносит проектировщик)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="ШАГ 1&lt;br&gt;источник?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="АНКЕТА · шаг 2&lt;br&gt;(только режим интервью)&lt;br&gt;6 вопросов владельцу вслух;&lt;br&gt;выход: бриф-черновик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="ДЕТЕКТОРЫ · шаг 3&lt;br&gt;скан текста:&lt;br&gt;ярлык без числа → «сколько?»&lt;br&gt;число без владельца → «кто установил?»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="ЩУПЫ · шаг 4&lt;br&gt;вопрос = щуп × цель&lt;br&gt;цели: поля 1–5 + сущности домена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="360" y="390" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="proto" value="ПРОТОКОЛ ОПРОСА&lt;br&gt;строка {вопрос · кандидат · статус · куда_ляжет}&lt;br&gt;инвариант: каждая строка получает судьбу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
